; Engine configuration file.

config_version=5

[application]

config/name="Merge Cats Defender"
config/description="Fusionne les chats, défends le mur contre les zombies !"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icons/icon_512.png"
boot_splash/bg_color=Color(0.16, 0.14, 0.2, 1)
boot_splash/show_image=false

[autoload]

A="*res://scripts/atlas.gd"
G="*res://scripts/game_state.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=2143
window/size/viewport_height=1062
window/size/window_width_override=1280
window/size/window_height_override=634
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[gui]

theme/custom_font="res://fonts/PassionOne-Regular.ttf"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.07, 0.1, 1)
textures/vram_compression/import_etc2_astc=true
